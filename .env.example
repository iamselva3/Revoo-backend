PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/revoo_dev
JWT_ACCESS_SECRET=revoo_super_secure_access_token_secret_key_2026_at_least_32_characters
JWT_REFRESH_SECRET=revoo_super_secure_refresh_token_secret_key_2026_at_least_32_characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Cloudflare R2 Object Storage
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_DOMAIN=

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=dummy
SMTP_PASS=dummy
EMAIL_FROM=support@revoo.com
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=dummy
WHATSAPP_ACCESS_TOKEN=dummy

# Google OAuth 2.0 Credentials (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/customer/google/callback


