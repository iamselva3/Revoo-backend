PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/revoo_dev
JWT_ACCESS_SECRET=revoo_super_secure_access_token_secret_key_2026_at_least_32_characters
JWT_REFRESH_SECRET=revoo_super_secure_refresh_token_secret_key_2026_at_least_32_characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# Photo storage. STORAGE_DRIVER=r2 + the R2 keys below = uploads go to the Cloudflare R2 bucket
# (served from R2_PUBLIC_DOMAIN). Without keys, uploads are saved to UPLOAD_DIR on this server.
STORAGE_DRIVER=r2
UPLOAD_DIR=uploads
# Cloudflare R2 Object Storage (keys: R2 > Manage API tokens, "Object Read & Write" on the bucket)
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=genie
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_DOMAIN=https://images.genietn.in

# --- Email OTP & notifications (nodemailer) ---
# Option A (Gmail / Google Workspace): set SMTP_SERVICE=gmail, SMTP_USER to the mailbox address
#   and SMTP_PASS to a 16-character App Password (Google Account -> Security -> App passwords).
# Option B (any SMTP provider: Brevo, SES, Zoho, Mailgun...): leave SMTP_SERVICE empty and set
#   SMTP_HOST / SMTP_PORT (587 = STARTTLS, 465 = SSL) plus the provider's SMTP username & key.
# While these are empty in development, OTP codes are printed to the server console instead.
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@genie.in
EMAIL_FROM_NAME=Genie
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=dummy
WHATSAPP_ACCESS_TOKEN=dummy

# Google OAuth 2.0 Credentials (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/customer/google/callback
# Optional: extra OAuth client IDs whose Google tokens are accepted (comma-separated),
# e.g. a separate web or Android client. GOOGLE_CLIENT_ID is always accepted.
GOOGLE_ALLOWED_CLIENT_IDS=


